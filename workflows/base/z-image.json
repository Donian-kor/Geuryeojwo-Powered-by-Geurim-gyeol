{
  "name": "기본 · Z-Image",
  "description": "Z-Image 계열 기본 워크플로. AIO 체크포인트(모델+CLIP+VAE가 한 파일)를 씁니다. shift 3.5 / steps 10 / cfg 1.1 / beta 는 Z-Anime 배포 워크플로의 값입니다.",
  "family": "zimage",
  "output_node": "7",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "" },
      "_meta": { "title": "체크포인트 로드 (AIO)" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["1", 1] },
      "_meta": { "title": "프롬프트" }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, watermark, jpeg artifacts, bad anatomy, deformed hands, extra fingers, missing fingers",
        "clip": ["1", 1]
      },
      "_meta": { "title": "네거티브" }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "_meta": { "title": "빈 잠재 이미지" }
    },
    "5": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": { "shift": 3.5, "sampling": "flow", "model": ["1", 0] },
      "_meta": { "title": "모델 샘플링 (AuraFlow)" }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 10, "cfg": 1.1,
        "sampler_name": "euler", "scheduler": "beta", "denoise": 1.0,
        "model": ["5", 0], "positive": ["2", 0], "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "_meta": { "title": "KSampler" }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["6", 0], "vae": ["1", 2] },
      "_meta": { "title": "VAE 디코드" }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "geuryeojwo/z-image", "images": ["7", 0] },
      "_meta": { "title": "이미지 저장" }
    }
  }
}