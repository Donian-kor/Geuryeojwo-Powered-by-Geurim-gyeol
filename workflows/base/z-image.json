{
  "name": "기본 · Z-Image",
  "description": "Z-Image 계열 기본 워크플로. 적은 스텝(8회)으로 빠르게 나옵니다.",
  "family": "zimage",
  "output_node": "10",
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "", "weight_dtype": "default" },
      "_meta": { "title": "확산 모델 로드" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "", "type": "lumina2", "device": "default" },
      "_meta": { "title": "CLIP 로드" }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "" },
      "_meta": { "title": "VAE 로드" }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["2", 0] },
      "_meta": { "title": "프롬프트" }
    },
    "5": {
      "class_type": "ConditioningZeroOut",
      "inputs": { "conditioning": ["2", 0] },
      "_meta": { "title": "조건 0으로" }
    },
    "6": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "_meta": { "title": "빈 잠재 이미지" }
    },
    "7": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": { "shift": 3, "sampling": "flow", "model": ["1", 0] },
      "_meta": { "title": "모델 샘플링 (AuraFlow)" }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 8, "cfg": 1.0,
        "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1.0,
        "model": ["7", 0], "positive": ["4", 0], "negative": ["5", 0],
        "latent_image": ["6", 0]
      },
      "_meta": { "title": "KSampler" }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["8", 0], "vae": ["3", 0] },
      "_meta": { "title": "VAE 디코드" }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "geuryeojwo/z-image", "images": ["9", 0] },
      "_meta": { "title": "이미지 저장" }
    }
  }
}