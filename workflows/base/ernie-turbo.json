{
  "name": "기본 · ERNIE (Turbo)",
  "description": "ERNIE-Image-Turbo 모델용. 8스텝 / cfg 1.0 이 정답값입니다. (Base 는 ernie.json)",
  "family": "ernie",
  "variant": "turbo",
  "output_node": "7",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "" },
      "_meta": { "title": "체크포인트 로드" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["1", 1] },
      "_meta": { "title": "프롬프트" }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["1", 1]
      },
      "_meta": { "title": "네거티브 (Turbo 는 cfg 1.0 이라 사용되지 않음)" }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": 1024, "height": 1536, "batch_size": 1 },
      "_meta": { "title": "빈 잠재 이미지" }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 8, "cfg": 1.0,
        "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
        "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "_meta": { "title": "KSampler" }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
      "_meta": { "title": "VAE 디코드" }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "geuryeojwo/ernie-turbo", "images": ["6", 0] },
      "_meta": { "title": "이미지 저장" }
    }
  }
}