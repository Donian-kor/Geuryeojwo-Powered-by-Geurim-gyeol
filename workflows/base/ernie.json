{
  "name": "기본 · ERNIE",
  "description": "ERNIE 계열 기본 워크플로. 체크포인트 하나만 필요합니다.",
  "family": "ernie",
  "output_node": "7",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "" },
      "_meta": { "title": "체크포인트 로드" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["1", 1] },
      "_meta": { "title": "프롬프트" }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "Avoid blurry, low-quality, noisy, oversmoothed, distorted or messy results. Avoid bad anatomy, deformed hands, extra fingers, fused fingers, missing fingers, watermark, text, logo.",
        "clip": ["1", 1]
      },
      "_meta": { "title": "네거티브" }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": 1024, "height": 1536, "batch_size": 1 },
      "_meta": { "title": "빈 잠재 이미지" }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 9, "cfg": 1.0,
        "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
        "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "_meta": { "title": "KSampler" }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
      "_meta": { "title": "VAE 디코드" }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "geuryeojwo/ernie", "images": ["6", 0] },
      "_meta": { "title": "이미지 저장" }
    }
  }
}