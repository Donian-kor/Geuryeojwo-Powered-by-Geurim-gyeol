{
  "name": "기본 · Flux",
  "description": "Flux 계열 기본 워크플로. CFG 를 1 로 두는 게 Flux 방식입니다. 네거티브 대신 조건을 0으로 만듭니다.",
  "family": "flux",
  "output_node": "9",
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "", "weight_dtype": "default" },
      "_meta": { "title": "확산 모델 로드" }
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "", "clip_name2": "", "type": "flux", "device": "default"
      },
      "_meta": { "title": "CLIP 로드 (2개)" }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "" },
      "_meta": { "title": "VAE 로드" }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "", "clip": ["2", 0] },
      "_meta": { "title": "프롬프트" }
    },
    "5": {
      "class_type": "ConditioningZeroOut",
      "inputs": { "conditioning": ["2", 0] },
      "_meta": { "title": "조건 0으로 (Flux 네거티브 자리는 비워둠)" }
    },
    "6": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "_meta": { "title": "빈 잠재 이미지" }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 20, "cfg": 1.0,
        "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
        "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0],
        "latent_image": ["6", 0]
      },
      "_meta": { "title": "KSampler" }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["7", 0], "vae": ["3", 0] },
      "_meta": { "title": "VAE 디코드" }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "geuryeojwo/flux", "images": ["8", 0] },
      "_meta": { "title": "이미지 저장" }
    }
  }
}